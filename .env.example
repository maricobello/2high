# =====================================================================
# Copie para .env.local (desenvolvimento) ou configure na Vercel.
# NUNCA use o prefixo NEXT_PUBLIC_ em chaves secretas — elas iriam para o navegador.
# =====================================================================

# ---------- Público (seguro no frontend) ----------
NEXT_PUBLIC_BRAND_NAME=Aferi
NEXT_PUBLIC_APP_URL=http://localhost:3000
# WhatsApp comercial (só dígitos, com DDI): botão "Falar com especialista"
NEXT_PUBLIC_COMMERCIAL_WHATSAPP=5511999999999
NEXT_PUBLIC_CONTACT_EMAIL=contato@suaempresa.com.br
NEXT_PUBLIC_DPO_EMAIL=privacidade@suaempresa.com.br
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_CNPJ=

# ---------- Banco de dados / Storage (Supabase) ----------
# Sem SUPABASE_URL o app usa armazenamento local em .data/ (apenas desenvolvimento).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=invoices
# DATA_DRIVER=supabase|local  (opcional, detectado automaticamente)

# ---------- IA (Groq por padrão; qualquer API compatível com OpenAI) ----------
GROQ_API_KEY=
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL_TEXT=llama-3.3-70b-versatile
# LLM_MODEL_FAST=llama-3.1-8b-instant
# LLM_MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct
# LLM_TIMEOUT_MS=25000

# ---------- OCR externo (opcional: PDFs digitalizados e fotos) ----------
OCR_SPACE_API_KEY=

# ---------- Painel administrativo ----------
ADMIN_EMAIL=admin@suaempresa.com.br
ADMIN_PASSWORD=troque-esta-senha
# Gere com: openssl rand -base64 48
AUTH_SECRET=

# ---------- E-mail (Resend) ----------
RESEND_API_KEY=
EMAIL_FROM="Diagnóstico de Energia <diagnostico@suaempresa.com.br>"
# Quem recebe alerta de novo lead (separe por vírgula)
ADMIN_NOTIFY_EMAILS=comercial@suaempresa.com.br

# ---------- WhatsApp ----------
# none | meta (WhatsApp Cloud API) | webhook (Z-API, Evolution API, n8n, Make…)
WHATSAPP_PROVIDER=none
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
# Template aprovado (1 variável no corpo) para mensagens fora da janela de 24h
META_WHATSAPP_TEMPLATE=
META_WHATSAPP_TEMPLATE_LANG=pt_BR
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
# Atendimento com IA respondendo automaticamente no WhatsApp (dentro da janela de 24h)
AI_WHATSAPP_AUTOREPLY=false
# WhatsApp do time para alertas de lead HOT (só dígitos, com DDI)
ADMIN_WHATSAPP=

# ---------- Webhooks de saída / integrações ----------
CRM_WEBHOOK_URL=
ADMIN_WEBHOOK_URL=
# Assinatura HMAC-SHA256 enviada no header X-Signature
WEBHOOK_SIGNING_SECRET=
# Token Bearer da API REST /api/v1/leads
API_TOKEN=

# ---------- Cron (Vercel envia Authorization: Bearer $CRON_SECRET) ----------
CRON_SECRET=

# ---------- Dados ANEEL (opcional) ----------
ANEEL_TARIFF_RESOURCE_ID=

# ---------- Feature flags ----------
FEATURE_FOLLOW_UPS_ENABLED=true
# Módulo 4 — Antecipação de benefício econômico (previsto, manter desligado)
FEATURE_ADVANCE_ENABLED=false
